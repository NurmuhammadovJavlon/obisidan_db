filters:
  and:
    - file.folder == "myvault/Brilliance/Skills/Customs clearance"
    - '!file.fullname.contains("base")'
views:
  - type: cards
    name: Table
    order:
      - file.name
      - Icon
      - Difficulty
      - tags
      - Completed
      - Created
    cardSize: 230
    imageAspectRatio: 0.7
