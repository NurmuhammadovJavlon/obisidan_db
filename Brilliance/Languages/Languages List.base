filters:
  and:
    - file.folder == "myvault/Brilliance/Languages"
    - '!file.fullname.contains("base")'
views:
  - type: cards
    name: Table
    order:
      - file.name
      - Icon
      - Level
      - Completed
      - Created
      - Goal
      - Note
    imageFit: contain
    cardSize: 220
