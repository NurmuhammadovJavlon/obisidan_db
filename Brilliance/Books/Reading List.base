filters:
  and:
    - file.folder == "myvault/Brilliance/Books"
    - '!file.fullname.contains("base")'
    - file.name != "Notes - Books in Mind"
views:
  - type: cards
    name: View 2
    groupBy:
      property: tags
      direction: ASC
    order:
      - file.name
      - author
      - Status
      - file.ctime
    sort:
      - property: Status
        direction: ASC
    cardSize: 200
    image: note.coverUrl
    imageAspectRatio: 1.45
  - type: cards
    name: View
    order:
      - file.name
      - tags
      - Status
      - totalPage
      - author
      - categories
    cardSize: 290
    image: note.coverUrl
    imageAspectRatio: 1
    imageFit: contain
  - type: table
    name: Table
    filters:
      and:
        - file.folder == "myvault/Brilliance/Books"
        - '!file.fullname.contains(".base")'
